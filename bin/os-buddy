#!/usr/bin/env bash
# os-buddy: entry point. Checks the system, loads the libraries,
# then runs an admin report, one goal (one-shot mode) or a chat.
#
# Exit codes: 0 done, 1 error, 2 usage error, 3 step limit reached.

set -u            # using a variable that was never set is an error
set -o pipefail   # a pipeline fails if any command in it fails

OSBUDDY_VERSION="0.1.0"

# Find this script's real folder, even when it is run through a symlink,
# so ../lib and ../share are found from anywhere.
OSBUDDY_BIN="$(readlink -f "${BASH_SOURCE[0]}")"
OSBUDDY_ROOT="$(cd "$(dirname "$OSBUDDY_BIN")/.." && pwd)"
OSBUDDY_SHARE="$OSBUDDY_ROOT/share"

# shellcheck source=../lib/load.sh
source "$OSBUDDY_ROOT/lib/load.sh"

# Print an error and quit with code 1.
die() {
  ui_error "$*"
  exit 1
}

# Refuse to run on Bash older than 4.4.
check_bash() {
  if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
    die "Bash 4.4 or newer is required (you have $BASH_VERSION)."
  fi
}

# Refuse to run on systems that are not Linux/Unix.
# WSL reports "Linux", so it passes. Git Bash / MSYS2 / Cygwin on Windows
# lack /proc and the Unix tools we use.
check_os() {
  local os
  os="$(uname -s)"
  case "$os" in
    Linux|Darwin|*BSD) ;;
    MINGW*|MSYS*|CYGWIN*)
      die "Windows ('$os') is not supported directly. Run os-buddy inside WSL (Windows Subsystem for Linux): open PowerShell, run 'wsl --install', restart, then use os-buddy in the Ubuntu terminal." ;;
    *) die "unsupported OS '$os'. Linux/Unix only." ;;
  esac
}

# Make sure the tools we depend on are installed.
check_deps() {
  local missing="" cmd
  for cmd in curl jq; do
    command -v "$cmd" > /dev/null 2>&1 || missing="$missing $cmd"
  done
  [[ -z "$missing" ]] || die "missing required tools:$missing"
}

chat_help() {
  ui_info "/status /health /disk /proc /users /backup show a report (they take the same"
  ui_info "words as the commands, e.g. /proc find ssh). /reset clears memory, /exit quits."
  ui_info "Anything else is a goal for the AI."
}

# Chat mode: read goals line by line. History is kept between turns.
chat_loop() {
  local line cmd rest
  ui_info "os-buddy $OSBUDDY_VERSION chat. Type /help for commands, /exit to quit."
  # -e gives arrow keys and line editing. Ctrl-D ends the chat.
  while read -r -e -p "you> " line; do
    case "$line" in
      "")      continue ;;
      /exit)   return 0 ;;
      /reset)  agent_reset; ui_success "history cleared" ;;
      /help)   chat_help ;;
      /*)      # A report command: run it directly, no AI needed.
               read -r cmd rest <<< "${line#/}"
               if admin_is_command "$cmd"; then
                 # shellcheck disable=SC2086  # split the rest into words on purpose
                 ( admin_run "$cmd" $rest )
               else
                 ui_error "unknown command /$cmd (try /help)"
               fi ;;
      *)       agent_run_goal "$line" ;;   # errors are shown, the chat goes on
    esac
  done
  echo >&2
}

main() {
  check_bash
  check_os

  # Admin commands (os-buddy disk, ...) need no API key, so they come first.
  if admin_is_command "${1:-}"; then
    admin_run "$@"
    exit $?
  fi

  check_deps
  config_load
  config_parse_args "$@"     # may exit with 0 (--help) or 2 (bad flag)

  [[ -n "${GEMINI_API_KEY:-}" ]] ||
    die "GEMINI_API_KEY is not set. Export it, or put it in $OSBUDDY_CONFIG_FILE"

  agent_init

  if [[ -n "$OSBUDDY_GOAL" ]]; then
    agent_run_goal "$OSBUDDY_GOAL"
    exit $?
  fi

  if ! ui_is_interactive; then
    ui_error "no goal given and no terminal for chat. Usage: os-buddy \"goal\""
    exit 2
  fi
  chat_loop
}

main "$@"
